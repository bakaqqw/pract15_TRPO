<Window x:Class="ElectronicsShop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource {x:Type Window}}"
        Title="Магазин электроники" Height="720" Width="1180"
        MinHeight="640" MinWidth="960" Loaded="Window_Loaded">

    <Grid Margin="12,9,19,13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,4,11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="9,3,0,0">
                <TextBlock Text="Магазин электроники" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="RoleText" Foreground="#49636A" Margin="7,8,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Click="Refresh_Click" Content="Обновить" Width="103" Height="39" Margin="0,11,23,0"/>
                <Button Click="GoBack_Click" Content="Сменить роль" Width="139" Height="36" Margin="0,2,5,0"/>
            </StackPanel>
        </Grid>

        <WrapPanel Grid.Row="1" x:Name="ManagerPanel" Margin="3,0,0,13">
            <Button Click="Create_Click" Content="Добавить товар" Width="152" Height="38" VerticalAlignment="Top" Margin="5,1,22,8"/>
            <Button Click="Categories_Click" Content="Категории" Width="123" Height="36" VerticalAlignment="Top" Margin="16,8,8,0"/>
            <Button Click="Brands_Click" Content="Бренды" Width="101" Height="40" VerticalAlignment="Top" Margin="2,0,28,6"/>
            <Button Click="Tags_Click" Content="Теги" Width="78" Height="36" VerticalAlignment="Top" Margin="10,12,0,0"/>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="235"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" Background="White" Padding="8,13,14,10" Margin="18,9,0,3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Фильтры" FontSize="18" FontWeight="Bold" Margin="7,0,0,12"/>
                        <Label Content="Категория:" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CategoryBox" ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectionChanged="Filter_SelectionChanged" Margin="3,0,7,13"/>

                        <Label Content="Бренд:" Margin="8,0,0,1"/>
                        <ComboBox x:Name="BrandBox" ItemsSource="{Binding Brands}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectionChanged="Filter_SelectionChanged" Margin="11,2,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,5,7,0">
                                <Label Content="Цена от:" Margin="0,0,0,5"/>
                                <TextBox x:Name="PriceFromBox" TextChanged="Search_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,14,0,0">
                                <Label Content="Цена до:" Margin="0,0,0,5"/>
                                <TextBox x:Name="PriceToBox" TextChanged="Search_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="FilterError" Foreground="#A52A2A" FontSize="11"
                                   TextWrapping="Wrap" MinHeight="40" Margin="0,5,0,5"/>
                        <Button Click="Reset_Click" Content="Сбросить" Width="117" Height="38" HorizontalAlignment="Left" Margin="19,4,0,14"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="0" Margin="0,3,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="7,4,21,0">
                        <Label Content="Поиск по наименованию:" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" MaxLength="200" Margin="9,0,0,7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,12,8,0">
                        <Label Content="Сортировка:" Margin="13,0,0,2"/>
                        <ComboBox x:Name="SortBox" SelectedIndex="0" SelectionChanged="Sort_SelectionChanged" Margin="4,0,0,0">
                            <ComboBoxItem Tag="NameAsc" Content="Наименование: А → Я"/>
                            <ComboBoxItem Tag="NameDesc" Content="Наименование: Я → А"/>
                            <ComboBoxItem Tag="PriceAsc" Content="Цена: по возрастанию"/>
                            <ComboBoxItem Tag="PriceDesc" Content="Цена: по убыванию"/>
                            <ComboBoxItem Tag="StockAsc" Content="Остаток: по возрастанию"/>
                            <ComboBoxItem Tag="StockDesc" Content="Остаток: по убыванию"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Click="View_Click" Content="Просмотреть" Width="137" Height="36" VerticalAlignment="Top" Margin="17,6,19,0"/>
                    <Button x:Name="EditButton" Click="Change_Click" Content="Изменить" Width="111" Height="40" VerticalAlignment="Top" Margin="3,0,34,5"/>
                    <Button x:Name="DeleteButton" Click="Delete_Click" Content="Удалить" Width="97" Height="36" VerticalAlignment="Top" Margin="0,9,0,0"/>
                </StackPanel>

                <ListView Grid.Row="2" x:Name="ProductsList" ItemsSource="{Binding Products}"
                          Background="Transparent" BorderThickness="0" Margin="0,5,6,0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,5,10"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="2" Padding="11,8,17,13" Margin="4,3,1,7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#AEC8CA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                <Setter Property="Background" Value="#E7FAF7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="125"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,15,0">
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                                            <TextBlock Text="Рейтинг: "/>
                                            <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}"/>
                                            <TextBlock Text=" / 5"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Категория: "/>
                                            <TextBlock Text="{Binding Category.Name}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                                            <TextBlock Text="Бренд: "/>
                                            <TextBlock Text="{Binding Brand.Name}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding TagsText}" Foreground="#007D87" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="0,7,3,0">
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        <Label Content="Цена:" Foreground="#49636A" HorizontalAlignment="Right" Margin="0,3,0,20"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="Остаток: "/>
                                            <TextBlock Text="{Binding Stock}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" x:Name="EmptyText" Text="Товары не найдены" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Label x:Name="InfoProducts" Content="Всего товаров: 0" Margin="6,0,27,0"/>
                <Label x:Name="InfoShown" Content="Показано: 0" Margin="9,6,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#49636A" TextWrapping="Wrap" Margin="18,2,0,0"/>
        </StackPanel>
    </Grid>
</Window>
