<Window x:Class="ElectronicsShop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource {x:Type Window}}"
        Title="Магазин электроники" Height="720" Width="1180"
        MinHeight="640" MinWidth="960" Loaded="Window_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Магазин электроники" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="RoleText" Foreground="#49636A" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Refresh_Click" Content="Обновить" Width="110" Margin="0,0,10,0"/>
                <Button Click="GoBack_Click" Content="Сменить роль" Width="140"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" x:Name="ManagerPanel" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Click="Create_Click" Content="Добавить товар" Width="160" Margin="0,0,10,0"/>
            <Button Click="Categories_Click" Content="Категории" Width="120" Margin="0,0,10,0"/>
            <Button Click="Brands_Click" Content="Бренды" Width="100" Margin="0,0,10,0"/>
            <Button Click="Tags_Click" Content="Теги" Width="90"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" Padding="10" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Фильтры" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Label Content="Категория:" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CategoryBox" ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectionChanged="Filter_SelectionChanged" Margin="0,0,0,10"/>

                        <Label Content="Бренд:" Margin="0,0,0,5"/>
                        <ComboBox x:Name="BrandBox" ItemsSource="{Binding Brands}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectionChanged="Filter_SelectionChanged" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <Label Content="Цена от:" Margin="0,0,0,5"/>
                                <TextBox x:Name="PriceFromBox" TextChanged="Search_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <Label Content="Цена до:" Margin="0,0,0,5"/>
                                <TextBox x:Name="PriceToBox" TextChanged="Search_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="FilterError" Foreground="#A52A2A" FontSize="11"
                                   TextWrapping="Wrap" MinHeight="40" Margin="0,5,0,5"/>
                        <Button Click="Reset_Click" Content="Сбросить" Margin="0,0,0,10"/>
                        <Button Click="View_Click" Content="Просмотреть" Margin="0,0,0,10"/>
                        <Button x:Name="EditButton" Click="Change_Click" Content="Изменить" Margin="0,0,0,10"/>
                        <Button x:Name="DeleteButton" Click="Delete_Click" Content="Удалить" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <Label Content="Поиск по наименованию:" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Label Content="Сортировка:" Margin="0,0,0,5"/>
                        <ComboBox x:Name="SortBox" SelectedIndex="0" SelectionChanged="Sort_SelectionChanged">
                            <ComboBoxItem Tag="NameAsc" Content="Наименование: от А до Я"/>
                            <ComboBoxItem Tag="NameDesc" Content="Наименование: от Я до А"/>
                            <ComboBoxItem Tag="PriceAsc" Content="Цена: по возрастанию"/>
                            <ComboBoxItem Tag="PriceDesc" Content="Цена: по убыванию"/>
                            <ComboBoxItem Tag="StockAsc" Content="Остаток: по возрастанию"/>
                            <ComboBoxItem Tag="StockDesc" Content="Остаток: по убыванию"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>


                <ListView Grid.Row="2" x:Name="ProductsList" ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,5,10"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="2" Padding="10" Margin="5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#AEC8CA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                <Setter Property="Background" Value="#E7FAF7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="125"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,15,0">
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                                            <TextBlock Text="Рейтинг: "/>
                                            <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}"/>
                                            <TextBlock Text=" / 5"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Категория: "/>
                                            <TextBlock Text="{Binding Category.Name}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                                            <TextBlock Text="Бренд: "/>
                                            <TextBlock Text="{Binding Brand.Name}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding TagsText}" Foreground="#007D87" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        <Label Content="Цена:" Foreground="#49636A" HorizontalAlignment="Right" Margin="0,3,0,20"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="Остаток: "/>
                                            <TextBlock Text="{Binding Stock}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" x:Name="EmptyText" Text="Товары не найдены" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Label x:Name="InfoProducts" Content="Всего товаров: 0" Margin="0,0,20,0"/>
                <Label x:Name="InfoShown" Content="Показано: 0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#49636A" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
