<Window x:Class="ElectronicsShop.Views.NameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Style="{StaticResource {x:Type Window}}"
        Title="Запись справочника" Height="270" Width="550" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">

    <Grid Margin="14,17,23,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" x:Name="Heading" FontSize="20" Margin="12,4,0,19"/>
        <Label Grid.Row="1" Content="Наименование:" FontSize="14" VerticalAlignment="Center" Margin="3,8,5,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="17,0,28,7"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="46,16,0,0">
            <Button Click="Save_Click" Content="Сохранить" Width="136" Height="40" VerticalAlignment="Top" IsDefault="True" Margin="0,0,0,7"/>
            <Button Click="GoBack_Click" Content="Назад" Width="92" Height="36" VerticalAlignment="Top" Margin="37,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
