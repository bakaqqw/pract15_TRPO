<Window x:Class="ElectronicsShop.Views.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource {x:Type Window}}"
        Title="Карточка товара" Height="650" Width="850" MinHeight="620" MinWidth="800"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock x:Name="Heading" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Все поля обязательны, кроме тегов" Foreground="#49636A" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" x:Name="FormGrid" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="135"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Наименование:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="NameBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="Field_TextChanged" Margin="0,0,0,10"/>

            <Label Grid.Row="1" Content="Цена:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PriceBox" TextChanged="Field_TextChanged" Margin="0,0,0,10"/>
            <Label Grid.Row="1" Grid.Column="2" Content="Остаток, шт.:" VerticalAlignment="Center" Margin="15,0,10,10"/>
            <TextBox Grid.Row="1" Grid.Column="3" x:Name="StockBox" TextChanged="Field_TextChanged" Margin="0,0,0,10"/>

            <Label Grid.Row="2" Content="Рейтинг, 0–5:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="RatingBox" TextChanged="Field_TextChanged" Margin="0,0,0,10"/>
            <Label Grid.Row="2" Grid.Column="2" Content="Дата:" FontSize="13" VerticalAlignment="Center" Margin="15,0,5,10"/>
            <DatePicker Grid.Row="2" Grid.Column="3" x:Name="CreatedPicker" SelectedDateChanged="Field_SelectionChanged" Margin="0,0,0,10"/>

            <Label Grid.Row="3" Content="Категория:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CategoryBox"
                      DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Field_SelectionChanged" Margin="0,0,0,10"/>

            <Label Grid.Row="4" Content="Бренд:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="BrandBox"
                      DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Field_SelectionChanged" Margin="0,0,0,10"/>

            <Label Grid.Row="5" Content="Описание:" VerticalAlignment="Top" Margin="0,8,10,10"/>
            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="DescriptionBox"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"
                     TextChanged="Field_TextChanged" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="6" Margin="0,5,10,0">
                <TextBlock Text="Теги"/>
            </StackPanel>
            <ListBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TagsList"
                     DisplayMemberPath="Name" SelectionMode="Multiple" SelectionChanged="Field_SelectionChanged"
                     Background="White" BorderBrush="#00b4c4" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Загрузка справочников…" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SaveButton" Click="Save_Click" Content="Сохранить" Width="140" IsEnabled="False" Margin="0,0,10,0"/>
                <Button x:Name="BackButton" Click="GoBack_Click" Content="Назад" Width="120"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
